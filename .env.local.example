# Supabase — copy this file to .env.local and fill in your project values.
# Find these in your Supabase project: Settings → API.
# Required. Supabase is the only auth backend — without these set, sign-up
# and sign-in will fail with a clear error instead of silently working.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never expose this in client-side code.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe billing — see .env.example for details. Optional locally; the
# Pricing page just shows an error on checkout until these are set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLAYER=
STRIPE_PRICE_FAMILY=
