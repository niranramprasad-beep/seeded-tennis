# Supabase — copy this file to .env.local. Use the STAGING project's values,
# never production's (README → Local setup).
# The two public values are all local development needs; without them the
# public pages work and sign-in shows a clear "not connected" message.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only, and NOT needed for local development (only the Whop billing
# routes and the staging catalog importer use it). Leave it blank.
SUPABASE_SERVICE_ROLE_KEY=

# Whop billing — see .env.example for details. This is what the live
# Pricing page uses. Optional locally; checkout just shows an error until set.
# The API key needs company scope: it must be able to read this account's
# memberships, or /api/whop/membership and the post-checkout sync both fail.
# A key that can only read public plan data returns 401 on memberships.list.
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=
WHOP_PLAN_PLAYER_MONTHLY=
WHOP_PLAN_PLAYER_YEARLY=
WHOP_PLAN_FAMILY_MONTHLY=
WHOP_PLAN_FAMILY_YEARLY=
# Legacy, resolve-only — see .env.example.
WHOP_PLAN_PLAYER=
WHOP_PLAN_FAMILY=
