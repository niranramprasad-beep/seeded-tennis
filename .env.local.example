# Supabase — copy this file to .env.local and fill in your project values.
# Find these in your Supabase project: Settings → API.
# Until both are set, Seeded uses a built-in local auth simulation so the
# full sign-up / family flow still works for development.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never expose this in client-side code.
SUPABASE_SERVICE_ROLE_KEY=
