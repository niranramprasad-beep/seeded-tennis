# Supabase
# Copy this file to .env.local for local development.
# Add the same values in Vercel Project Settings → Environment Variables.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Do not use this in browser/client code.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Used by /api/match-analysis for match note analysis.
# You can use either name; OPENAI_API_KEY is preferred.
OPENAI_API_KEY=
CHATGPT_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Whop billing — this is what the live Pricing page actually uses.
# Without these, the Pricing page shows an error instead of starting
# checkout — everything else still works.
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=
WHOP_PLAN_PLAYER=
WHOP_PLAN_FAMILY=

# Stripe billing — built but not wired into the UI. Kept here in case you
# switch back; harmless to leave unset.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLAYER=
STRIPE_PRICE_FAMILY=
