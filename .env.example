# Seeded environment variables — PLACEHOLDERS ONLY. Never commit real values.
# Copy to .env.local for local dev. Set the same NAMES in Vercel per environment.
# Local + Preview must point at a STAGING Supabase project, never production
# (see docs/DEPLOYMENT_CHECKLIST.md).

# --- Supabase (required) -------------------------------------------------
# Public. Read in browser + API routes. Missing -> auth and all data fail.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback name read by one code path; prefer the PUBLISHABLE key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret, server-only (lib/supabase/admin.ts). Used by the Whop webhook and
# /api/whop/membership. Missing -> webhook returns 500, billing page shows
# tier only. NEVER prefix with NEXT_PUBLIC_. Production only.
SUPABASE_SERVICE_ROLE_KEY=

# --- Whop billing (required for paid plans) --------------------------------
# Secret, server-only. Missing -> checkout returns "Billing isn't configured".
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=
# Plan IDs (not secret). Missing -> checkout returns "Unknown plan".
WHOP_PLAN_PLAYER=
WHOP_PLAN_FAMILY=

# --- Analytics (optional) --------------------------------------------------
# Public GA4 measurement ID (client tag).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Secret, server-only. Lets the Whop webhook report purchase events.
GA4_MEASUREMENT_PROTOCOL_API_SECRET=

# --- REMOVED --------------------------------------------------------------
# Nothing below is read by the code any more. Listed so that whoever prunes
# the Vercel environment knows exactly what is safe to delete there, and so
# nobody re-adds a var expecting it to do something.
#
# GEMINI_API_KEY        removed with /api/training/copilot (P1-SEC-1).
#                       Delete from Vercel and REVOKE the key at Google — an
#                       unused key in an env var is still a live credential.
# STRIPE_SECRET_KEY     removed with /api/stripe/* and lib/stripe.ts
# STRIPE_WEBHOOK_SECRET (P1-SEC-5). Billing is Whop only. Delete from Vercel
# STRIPE_PRICE_PLAYER   and revoke the secret key in the Stripe dashboard.
# STRIPE_PRICE_FAMILY   The profiles.stripe_* columns stay until a cleanup
#                       migration; no code reads them.
