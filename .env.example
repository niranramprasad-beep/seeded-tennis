# Seeded environment variables — PLACEHOLDERS ONLY. Never commit real values.
# Copy to .env.local for local dev. Set the same NAMES in Vercel per environment.
# Local + Preview must point at a STAGING Supabase project, never production
# (see docs/DEPLOYMENT_CHECKLIST.md).
#
# This file is the authoritative list: it names every variable the code reads
# and nothing else. If a name isn't here, no code path looks it up — so a
# variable set in Vercel but absent here is dead weight and should be deleted
# there. Keep it that way; a stale entry is how a removed integration's
# credential ends up living on unnoticed.

# --- Supabase (required) -------------------------------------------------
# Public. Read in browser + API routes. Missing -> auth and all data fail.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback name read by one code path; prefer the PUBLISHABLE key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret, server-only (lib/supabase/admin.ts). Used by the Whop webhook and
# /api/whop/membership. Missing -> webhook returns 500, billing page shows
# tier only. NEVER prefix with NEXT_PUBLIC_. Production only.
SUPABASE_SERVICE_ROLE_KEY=

# --- Whop billing (required for paid plans) --------------------------------
# Secret, server-only. Missing -> checkout returns "Billing isn't configured".
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=
# Plan IDs (not secret). Whop models monthly and yearly as two separate
# plans on one product, so each tier needs two. A missing one makes that
# tier+interval unbuyable ("That plan isn't available right now") rather
# than falling back to another price — see lib/whop.ts planIdFor().
WHOP_PLAN_PLAYER_MONTHLY=
WHOP_PLAN_PLAYER_YEARLY=
WHOP_PLAN_FAMILY_MONTHLY=
WHOP_PLAN_FAMILY_YEARLY=
# The two plans sold Oct-Nov 2026 ($19 Player, $39 Family). RESOLVE-ONLY:
# people are subscribed on them, so a webhook for one has to map to the right
# tier — but planIdFor() never returns them, so no new checkout can start on
# an old price. Do not delete these while anyone still holds one.
WHOP_PLAN_PLAYER=
WHOP_PLAN_FAMILY=

# --- Analytics (optional) --------------------------------------------------
# Public GA4 measurement ID (client tag).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Secret, server-only. Lets the Whop webhook report purchase events.
GA4_MEASUREMENT_PROTOCOL_API_SECRET=

# The AI and Stripe variables that used to follow were removed along with
# their routes (P1-SEC-1 / P1-SEC-5). See docs/API_INTEGRATIONS.md.

# --- Feature flags (optional; only the exact string "true" turns one on) ----
# Catalog phase 1: show programs imported from official rosters (migration
# 048) on /schools. Off by default; turn on only once 048 and the roster
# import are on the target project. lib/config/catalog.ts.
NEXT_PUBLIC_CATALOG_PHASE1_ENABLED=
# Script-only (scripts/import-rosters.ts --upsert): the STAGING project URL.
# The importer refuses production. Falls back to NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=
