# UI-audit evidence: 21MB of PNGs. Durable copy lives outside the repo at
# ~/seeded-evidence/polish/ (README there explains how to read it).
# Regenerate with: node scripts/ui-audit.mjs <label> <light|dark>
docs/screenshots/

# Tracked on purpose: placeholders only (names, no values). Everything else
# matching .env* above stays ignored, including .env.local.prod-backup.
!.env.example
!.env.local.example

# Never commit credentials, dumps or browser auth state.
*.prod-backup
*.key
*.dump
*.p12
playwright/.auth/
**/storageState*.json
*.auth.json

# Raw roster files name real students (one row per player, with hometowns).
# They live only on the owner's machine, in ~/seeded-private/ (chmod 600).
# The repo holds the aggregate (docs/data/roster_counts_*.tsv, no names).
# lib/catalog/roster-counts.test.ts fails if a raw file is ever tracked.
seeded-private/
**/seeded-private/**
official_rosters_*.tsv
**/official_rosters_*.tsv
